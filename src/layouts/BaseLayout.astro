---
// BaseLayout :  Sinapeos cinematic dark theme
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  publishedTime?: string;
  article?: boolean;
  image?: string;
  genre?: string;
}

const { title, description, canonical, publishedTime, article, image, genre } = Astro.props;
const siteName = 'Sinapeos';
const siteUrl = 'https://sinapeos.com';
const defaultImage = '/images/og-default.jpg';
const ogImage = image || defaultImage;
const url = canonical ? `${siteUrl}${canonical}` : Astro.url.href;
---

<!DOCTYPE html>
<html lang="en" data-genre={genre || 'default'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | {siteName}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={url} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script>(function(){var p=window.location.pathname;var r=document.referrer||'';(new Image()).src='http://localhost:8085/track?s=sinapeos&p='+encodeURIComponent(p)+'&r='+encodeURIComponent(r)})();</script>
  <link rel="alternate icon" href="/favicon.ico" type="image/x-icon" sizes="16x16 32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

  <!-- Open Graph -->
  <meta property="og:title" content={`${title} | ${siteName}`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:site_name" content={siteName} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} | ${siteName}`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

  {article && (
    <>
      <meta property="article:published_time" content={publishedTime || new Date().toISOString()} />
      <meta property="article:author" content="Sinapeos" />
    </>
  )}

  <!-- Structured Data -->
  {article && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description,
      "author": { "@type": "Person", "name": "Sinapeos" },
      "publisher": {
        "@type": "Organization",
        "name": siteName,
        "logo": { "@type": "ImageObject", "url": `${siteUrl}/images/logo.png` }
      },
      "datePublished": publishedTime || new Date().toISOString().split('T')[0],
    }, null, 2)} />
  )}

  <!-- Base Styles -->
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Lexend:wght@300..700&display=swap');

    :root {
      --bg: #121212;
      --bg-card: #1e1e24;
      --bg-hover: #282830;
      --text: #e6e6e6;
      --text-dim: #a0a0a8;
      --accent: #f5c842;
      --accent-dim: #d4b035;
      --border: #2a2a32;
      --font-sans: 'Lexend', system-ui, -apple-system, sans-serif;
      --font-serif: Georgia, 'Times New Roman', serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: var(--font-sans);
      background: var(--bg);
      color: var(--text);
      font-size: 1rem;
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, h4 {
      font-family: var(--font-serif);
      font-weight: 600;
      line-height: 1.3;
      color: #fff;
    }

    a { color: var(--accent); text-decoration: none; transition: opacity 0.2s; }
    a:hover { opacity: 0.8; }

    img { max-width: 100%; height: auto; border-radius: 8px; }

    pre, code { font-family: 'JetBrains Mono', monospace; }

    ::selection { background: #f5e6a8; color: #121212; }
  
    .footer-sisters {
      font-size: 0.78rem; color: var(--text-dim); margin-top: 0.75rem;
      padding-top: 0.75rem; border-top: 1px solid var(--border);
      display: flex; justify-content: center; gap: 0.4rem; flex-wrap: wrap;
    }
    .footer-sisters span { color: var(--text-dim); }
    .footer-sisters a { color: var(--text-dim); text-decoration: underline; }
    .footer-sisters a:hover { color: var(--accent); }
</style>

  <!-- Article-specific styles -->
  {article && (
    <style is:global>
      .article-body h2 {
        font-size: 1.6rem;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        color: #fff;
        border-bottom: 1px solid var(--border);
        padding-bottom: 0.5rem;
      }

      .article-body h3 {
        font-size: 1.2rem;
        margin-top: 1.8rem;
        margin-bottom: 0.8rem;
        color: var(--accent);
      }

      .article-body p {
        margin-bottom: 1.2rem;
        font-size: 1.15rem;
        font-family: var(--font-serif);
        line-height: 1.8;
        color: var(--text);
      }

      .article-body blockquote {
        border-left: 3px solid var(--accent);
        padding: 1rem 1.5rem;
        margin: 1.5rem 0;
        background: var(--bg-card);
        border-radius: 0 8px 8px 0;
        font-style: italic;
        font-family: var(--font-serif);
        color: var(--text);
      }

      .article-body ul, .article-body ol {
        margin: 1rem 0 1.5rem 1.5rem;
        font-family: var(--font-serif);
        line-height: 1.8;
      }

      .article-body li { margin-bottom: 0.4rem; }

      .article-body .callout {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1.2rem;
        margin: 1.5rem 0;
      }

      .article-body .callout-title {
        font-weight: 600;
        color: var(--accent);
        margin-bottom: 0.4rem;
        font-family: var(--font-sans);
      }

      .article-body img {
        margin: 1.5rem auto;
        display: block;
        max-width: 100%;
        border-radius: 8px;
      }

      .article-body .img-caption {
        text-align: center;
        color: var(--text-dim);
        font-size: 0.85rem;
        margin-top: -1rem;
        margin-bottom: 1.5rem;
      }

      .article-body .callout strong { color: var(--accent); }

      /* ── Article Header ── */
      .article-header { margin-bottom: 2rem; }
      .article-header .meta {
        font-size: 0.85rem; color: var(--text-dim); margin-bottom: 0.75rem;
        font-family: var(--font-sans); display: flex; gap: 0.5rem; align-items: center;
      }
      .article-header .pill {
        font-size: 0.72rem; padding: 0.15rem 0.55rem; border-radius: 4px;
        background: var(--bg-card); border: 1px solid var(--border); color: var(--accent-dim);
        text-transform: uppercase; letter-spacing: 0.05em; font-weight: 500;
      }
      .article-header h1 { font-size: 2.2rem; margin-bottom: 0.5rem; }
      .article-header .dek {
        font-size: 1.05rem; color: var(--text-dim); line-height: 1.7;
        font-family: var(--font-serif);
      }

      /* ── Table of Contents ── */
      .toc {
        background: var(--bg-card); border: 1px solid var(--border);
        border-radius: 8px; padding: 1.25rem 1.5rem; margin-bottom: 2rem;
        font-size: 0.85rem; font-family: var(--font-sans);
      }
      .toc-title {
        font-weight: 600; font-size: 0.78rem; text-transform: uppercase;
        letter-spacing: 0.06em; color: var(--accent); margin-bottom: 0.75rem;
      }
      .toc ol { list-style: none; padding: 0; margin: 0; }
      .toc li { margin-bottom: 0.3rem; }
      .toc a { color: var(--text-dim); text-decoration: none; }
      .toc a:hover { color: var(--accent); }

      /* ── Article Body ── */
      .article-body { max-width: 720px; margin: 0 auto; }
      .article-body .callout strong { color: var(--accent); }

      /* ── Sources Block ── */
      .sources-block {
        margin-top: 3rem; padding: 1.5rem; background: var(--bg-card);
        border: 1px solid var(--border); border-radius: 8px;
        font-family: var(--font-sans); font-size: 0.9rem; color: var(--text-dim);
        list-style-position: inside;
      }
      .sources-block h3 {
        color: var(--accent); font-family: var(--font-sans); font-size: 1rem;
        margin-bottom: 0.8rem;
      }
      .sources-block li { margin-bottom: 0.4rem; }

      /* ── Related Posts ── */
      .related-posts { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border); }
      .related-posts h3 {
        font-family: var(--font-sans); font-size: 1rem; margin-top: 0;
        margin-bottom: 1rem; color: var(--text-dim);
      }
      .related-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
      .related-card {
        padding: 1rem; border: 1px solid var(--border); border-radius: 8px;
        text-decoration: none; transition: all 0.15s;
        background: var(--bg-card);
      }
      .related-card:hover {
        border-color: var(--accent-dim); background: var(--bg-hover);
      }
      .related-card .cat {
        font-size: 0.68rem; font-weight: 600; text-transform: uppercase;
        letter-spacing: 0.06em; color: var(--accent);
      }
      .related-card .title {
        font-size: 0.9rem; font-weight: 600; color: #fff; margin-top: 0.25rem;
      }

      /* ── Disclaimer ── */
      .disclaimer {
        margin-top: 2rem; padding: 1rem 1.25rem;
        background: var(--bg-card); border-radius: 8px;
        font-size: 0.78rem; color: var(--text-dim); line-height: 1.5;
      }

      /* ── Share Section ── */
      .share-section {
        max-width: 600px; margin: 2.5rem auto 0; text-align: center;
      }
      .share-label {
        font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em;
        color: var(--text-dim); margin-bottom: 0.75rem; font-family: var(--font-sans);
      }
      .share-links { display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; }
      .share-btn {
        display: inline-flex; align-items: center; gap: 0.4rem;
        padding: 0.5rem 0.85rem; border-radius: 6px; font-size: 0.82rem;
        text-decoration: none; cursor: pointer; transition: all 0.15s;
        background: var(--bg-card); border: 1px solid var(--border); color: var(--text-dim);
        font-family: var(--font-sans);
      }
      .share-btn:hover { background: var(--bg-hover); border-color: var(--accent-dim); color: var(--accent); }
      .share-btn .share-icon { width: 16px; height: 16px; }
      .share-btn.copy-btn { border-style: dashed; }
      .share-btn.copy-btn:hover { border-style: solid; background: var(--accent); color: #121212; border-color: var(--accent); }

      /* ── Responsive ── */
      @media (max-width: 600px) {
        .related-grid { grid-template-columns: 1fr; }
        .article-header h1 { font-size: 1.6rem; }
      }
    </style>
  )}
</head>
<body>
  <header>
    <nav>
      <a href="/" class="logo">
        <span class="logo-mark">✦</span>
        <span class="logo-text">Sinapeos</span>
      </a>
      <div class="nav-links">
        <a href="/">Stories</a>
        <a href="/about">About</a>
      </div>
    </nav>
  </header>

  <main>
    <slot />
    {article && (
      <div class="share-section">
        <div class="share-label">Share this story</div>
        <div class="share-links">
          <a href={`https://reddit.com/submit?url=${encodeURIComponent(url)}&title=${encodeURIComponent(title)}`} target="_blank" rel="noopener" class="share-btn reddit">
            <svg class="share-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2A10 10 0 0 0 2 12a10 10 0 0 0 10 10 10 10 0 0 0 10-10A10 10 0 0 0 12 2m5.4 6.5c.8 0 1.4.6 1.4 1.4 0 .6-.3 1-.7 1.2.1.5.1 1 .1 1.5 0 2.7-2.5 5-5.9 5S6.7 14.8 6.7 12c0-.5 0-1 .1-1.4-.4-.3-.7-.7-.7-1.2 0-.8.6-1.4 1.4-1.4.4 0 .8.2 1.1.5 1-.7 2.4-1.2 3.9-1.3l.7-3.2.1-.1 2.3.5c.2-.4.6-.7 1.1-.7.7 0 1.2.6 1.2 1.2 0 .7-.6 1.2-1.2 1.2-.6 0-1.1-.5-1.2-1l-1.9-.4-.5 2.6c1.4.1 2.7.5 3.7 1.2.3-.3.6-.4 1-.4M8.7 10.6c-.6 0-1 .5-1 1s.5 1 1 1 1-.5 1-1-.4-1-1-1m3.8 4.5c.6-.6 1.6-.6 2.2 0 .2.2.5.2.7 0 .2-.2.2-.5 0-.7-.9-1-2.5-1-3.4 0-.4-.4-.7-.7-.4-.4 0-.7.3-.4.7.9.9.9 2.5 0 3.4-.2.2-.2.5 0 .7.2.2.5.2.7 0m.3-3.5c-.6 0-1 .5-1 1s.5 1 1 1 1-.5 1-1-.5-1-1-1m4.6 0c-.6 0-1 .5-1 1s.4 1 1 1c.5 0 1-.5 1-1s-.4-1-1-1Z"/></svg>
            <span>Reddit</span>
          </a>
          <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`} target="_blank" rel="noopener" class="share-btn twitter">
            <svg class="share-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href={`https://facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} target="_blank" rel="noopener" class="share-btn facebook">
            <svg class="share-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.04C6.5 2.04 2 6.53 2 12.06C2 17.06 5.66 21.21 10.44 21.96V14.96H7.9V12.06H10.44V9.85C10.44 7.34 11.93 5.96 14.22 5.96C15.31 5.96 16.45 6.15 16.45 6.15V8.62H15.19C13.95 8.62 13.56 9.39 13.56 10.18V12.06H16.34L15.89 14.96H13.56V21.96A10 10 0 0 0 22 12.06C22 6.53 17.5 2.04 12 2.04Z"/></svg>
            <span>Facebook</span>
          </a>
          <button class="share-btn copy-btn" id="copyLinkBtn">
            <svg class="share-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M16 1H4a2 2 0 0 0-2 2v14h2V3h12V1zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H8V7h11v14z"/></svg>
            <span id="copyLabel">Copy link</span>
          </button>
        </div>
      </div>
    )}
  </main>

  <footer>
    <div class="footer-inner">
      <div class="footer-brand">
        <span class="logo-mark">✦</span>
        <span>Sinapeos</span>
      </div>
      <p class="footer-tagline">The fix we didn't know we needed.</p>
      <p class="footer-copy">Stories of humanity solving hard problems.</p>
    </div>
    <div class="footer-sisters">
      <span>Also visit:</span>
      <a href="https://tabletopharvest.com" target="_blank" rel="nofollow">Tabletop Harvest</a>
      <a href="https://garagetoolsdb.com" target="_blank" rel="nofollow">GarageToolsDB</a>
      <a href="https://tabletoppicks.com" target="_blank" rel="nofollow">Tabletop Picks</a>
    </div>
  </footer>
{article && (
      <script>
        (function() {
          var btn = document.getElementById('copyLinkBtn');
          var label = document.getElementById('copyLabel');
          if (btn) {
            btn.addEventListener('click', async function() {
              try {
                await navigator.clipboard.writeText(window.location.href);
                label.textContent = 'Copied!';
                setTimeout(function() { label.textContent = 'Copy link'; }, 2500);
              } catch {
                label.textContent = 'Failed';
                setTimeout(function() { label.textContent = 'Copy link'; }, 2000);
              }
            });
          }
        })();
      </script>
    )}
  </body>
</html>

<style is:global>
  /* Navigation */
  header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(12px);
    background: rgba(13, 13, 15, 0.9);
  }

  nav {
    max-width: 820px;
    margin: 0 auto;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #fff;
  }

  .logo-mark {
    color: var(--accent);
    font-size: 1.3rem;
  }

  .logo-text { letter-spacing: -0.01em; }

  .nav-links {
    display: flex;
    gap: 1.5rem;
  }

  .nav-links a {
    color: var(--text-dim);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-links a:hover { color: var(--text); }

  /* Main */
  main {
    max-width: 740px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem;
    min-height: 70vh;
  }

  /* Footer */
  footer {
    border-top: 1px solid var(--border);
    padding: 2.5rem 1.25rem;
    margin-top: 4rem;
  }

  .footer-inner {
    max-width: 740px;
    margin: 0 auto;
    text-align: center;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .footer-tagline {
    color: var(--text-dim);
    font-style: italic;
    font-size: 0.95rem;
    margin-bottom: 0.3rem;
  }

  .footer-copy {
    color: var(--text-dim);
    font-size: 0.8rem;
    opacity: 0.7;
  }

  /* Story card */
  .story-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
    transition: border-color 0.2s, background 0.2s;
    cursor: pointer;
  }

  .story-card:hover {
    border-color: var(--accent-dim);
    background: var(--bg-hover);
  }

  .story-card h2 {
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
    color: #fff;
  }

  .story-card p {
    color: var(--text-dim);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .story-meta {
    display: flex;
    gap: 0.8rem;
    font-size: 0.8rem;
    color: var(--text-dim);
    margin-bottom: 0.5rem;
    margin-top: 0.5rem;
  }

  .story-meta span { opacity: 0.7; }
</style>