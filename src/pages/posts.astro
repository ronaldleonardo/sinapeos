---
import BaseLayout from '../layouts/BaseLayout.astro';
import { stories } from '../data/stories.js';
---

<BaseLayout title="All Stories: Sinapeos" description="Stories of humanity solving hard problems. Ozone, rivers, polio, DDT, acid rain, green revolution, and more." canonical="/posts">
  <h1 style="font-size: 2rem; margin-bottom: 0.5rem;">All Stories</h1>
  <p style="color: var(--text-dim); margin-bottom: 2rem;">{stories.length} stories. One new story every week, and two series to follow: <a href="/series">see the series</a>.</p>

  <div class="story-list">
    {stories.map((story) => (
      <a href={`/posts/${story.slug}`} class="story-card">
        <div class="story-meta">
          <span>{story.date}</span>
          {story.topics.map((t) => <span class="topic-tag">{t}</span>)}
        </div>
        <h2>{story.title}</h2>
        <p>{story.desc}</p>
      </a>
    ))}
  </div>
</BaseLayout>

<style is:global>
  .story-list {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .story-card { text-decoration: none; display: block; }
  .topic-tag {
    background: var(--bg-hover);
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    color: var(--accent);
  }
</style>
