---
import BaseLayout from '../layouts/BaseLayout.astro';

const stories = [
  { title: "London Blamed the Smell. The Water Was Killing Them.", slug: "london-sewers-great-stink", date: "2026-10-09", topics: ["The Unnoticed Fix", "Public Health"], desc: "In 1858 the Thames stank so badly that Parliament fled the building. Cholera had already killed 31,000 Londoners. The fix was a tunnel nobody could see." },
  { title: "Jersey City Was Drinking Its Own Sewage", slug: "chlorination-jersey-city", date: "2026-10-08", topics: ["The Unnoticed Fix", "Public Health"], desc: "In 1896 typhoid killed 85 people out of every 100,000 in Jersey City. The fix arrived in 1908, done in secret, and the man behind it could have gone to prison for it." },
  { title: "New York's Milk Was Killing 8,000 Babies a Year", slug: "pasteurization-milk-infant-mortality", date: "2026-10-08", topics: ["The Unnoticed Fix", "Public Health"], desc: "In the 1850s, most of the milk sold in New York City came from cows kept in distillery stalls, fed boiling alcohol waste. The New York Times reported an estimate that in one year, 8,000 infants died from it." },
  { title: "The Diagnosis That Killed Children Within a Year", slug: "insulin-1921-death-sentence", date: "2026-10-08", topics: ["The Unnoticed Fix", "Public Health"], desc: "Before 1922, a child diagnosed with type 1 diabetes was put on a starvation diet and given roughly three years. The only treatment made them die slowly instead of quickly. That year, two men in Toronto found a way to keep them alive." },
  { title: "Surgery Meant Being Held Down While You Screamed", slug: "anesthesia-ether-1846", date: "2026-10-08", topics: ["The Unnoticed Fix", "Public Health"], desc: "Before October 16, 1846, an operation was performed on a patient held down on a wooden bench, and speed was the only mercy available. A surgeon who could take off a leg in 25 seconds was considered kind." },
  { title: "A Generation of Children Grew Up Damaged by Their Soil", slug: "iodized-salt-goiter-belt", date: "2026-10-08", topics: ["The Unnoticed Fix", "Public Health"], desc: "In the Great Lakes states before 1924, iodine deficiency was so common that schoolchildren carried visible goiters, and pregnant women were passing irreversible brain damage to their babies. The fix arrived in a grocery aisle." },
  { title: "There Is No Cure for the Guinea Worm. The World Nearly Erased It Anyway.", slug: "guinea-worm-eradication", date: "2026-10-07", topics: ["Medicine", "Public Health"], desc: "It has no vaccine and no medicine. In 1986 it struck 3.5 million people a year. Today, just 10 cases remain on Earth. This is how the world nearly ended it." },
  { title: "They Called It the Perfect Drug. One FDA Reviewer Said No.", slug: "thalidomide-frances-kelsey", date: "2026-10-02", topics: ["Medicine", "Public Health"], desc: "A brand-new FDA reviewer read a 'perfect' sleeping pill with no lethal dose. She said no, four times. That no saved America from the disaster that crippled 8,000 babies worldwide." },
  { title: "The Whales That Came Back: How the World Stopped Hunting Them", slug: "whaling-ban-whale-recovery", date: "2026-09-21", topics: ["Environment", "Ocean"], desc: "In 1975 a rubber boat got between a Soviet harpoon and a dying whale. That photo ended the industry. The whales came back by the thousands." },
  { title: "The Death Sentence That Became a Daily Pill: How HIV Got Managed", slug: "hiv-treatment-revolution", date: "2026-09-18", topics: ["Medicine", "Public Health"], desc: "In 1995, a positive test was a death sentence. One man found the virus making billions of copies a day, then changed the shape of the fight." },
  { title: "The Man Who Saved a Billion Lives: Norman Borlaug and the Green Revolution", slug: "norman-borlaug-green-revolution", date: "2026-09-16", topics: ["Science", "Food"], desc: "In 1968, the bestseller 'The Population Bomb' predicted hundreds of millions would starve. What happened instead is a story almost nobody knows." },
  { title: "The Spray That Almost Killed America's Bird: How the Bald Eagle Came Back", slug: "bald-eagle-recovery", date: "2026-09-14", topics: ["Environment", "Policy"], desc: "The bird that was whittled down to 487 pairs now soars over every state. Here is how it survived us." },
  { title: "The Scourge That Paralyzed a Nation: How One Man's Needle Ended Polio", slug: "polio-eradication", date: "2026-09-14", topics: ["Medicine", "Public Health"], desc: "In 1952, polio paralyzed 21,000 Americans in one year. One vaccine, one global campaign, and 99.99% of the disease is gone." },
  { title: "The Disease That Killed 300 Million: How Humanity Wiped It Out", slug: "smallpox-eradication", date: "2026-09-13", topics: ["Medicine", "Public Health"], desc: "Smallpox killed more people than all 20th-century wars combined. Then we erased it." },
  { title: "The Rain That Was Killing Lakes: How Cap-and-Trade Fixed Acid Rain", slug: "acid-rain-solved", date: "2026-09-13", topics: ["Environment", "Policy"], desc: "Acid rain was destroying lakes across the US. A market-based solution fixed it faster than anyone predicted." },
  { title: "The River That Caught Fire: How We Brought It Back", slug: "cuyahoga-river-cleanup", date: "2026-09-03", topics: ["Environment", "Policy"], desc: "The Cuyahoga River burned 13 times. Now 60 species swim there." },
  { title: "The Hole in the Sky: How Humanity Saved the Ozone Layer", slug: "ozone-hole-healing", date: "2026-09-01", topics: ["Environment", "International Cooperation"], desc: "How humanity fixed the ozone layer." },
];
---

<BaseLayout title="All Stories: Sinapeos" description="Stories of humanity solving hard problems. Ozone, rivers, polio, DDT, acid rain, green revolution, and more." canonical="/posts">
  <h1 style="font-size: 2rem; margin-bottom: 0.5rem;">All Stories</h1>
  <p style="color: var(--text-dim); margin-bottom: 2rem;">{stories.length} stories. New ones every Mon, Wed, Fri.</p>

  <div class="story-list">
    {stories.map((story) => (
      <a href={`/posts/${story.slug}`} class="story-card">
        <div class="story-meta">
          <span>{story.date}</span>
          {story.topics.map((t) => <span class="topic-tag">{t}</span>)}
        </div>
        <h2>{story.title}</h2>
        <p>{story.desc}</p>
      </a>
    ))}
  </div>
</BaseLayout>

<style is:global>
  .story-list {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .story-card { text-decoration: none; display: block; }
  .topic-tag {
    background: var(--bg-hover);
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    color: var(--accent);
  }
</style>
